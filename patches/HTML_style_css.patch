+
+.search-container {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    margin-bottom: 10px;
+}
+
+.search-box {
+    width: 300px;
+    padding: 10px;
+    font-size: 16px;
+    border: 1px solid var(--table-border-color);
+    border-radius: 5px;
+    color: var(--main-font-color);
+    background-color: var(--table-alternate-background-color);
+    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
+}
+
+.ship-table-column-controls {
+    display: flex;
+    align-items: center;
+}
+
+.ship-table-column-dropdown {
+    position: relative;
+    margin-right: 10px;
+}
+
+.ship-table-column-dropdown-toggle {
+    padding: 10px;
+    font-size: 16px;
+    color: var(--menu-font-color);
+    background-color: var(--menu-background-color);
+    cursor: pointer;
+    border: none;
+}
+
+.ship-table-column-dropdown-menu {
+    display: none;
+    position: absolute;
+    right: 0;
+    background-color: var(--menu-background-color);
+    color: var(--menu-font-color);
+    min-width: 200px;
+    max-height: 200px;
+    overflow-y: auto;
+    box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
+    padding: 12px;
+    z-index: 1;
+}
+
+.ship-table-column-dropdown-item {
+    display: block;
+    padding: 8px;
+    cursor: pointer;
+}
+
+.ship-table-column-dropdown-item:hover {
+    background-color: var(--menu-background-hover-color);
+}
+
+.ship-table-column-dropdown-item input { 
+    margin-right: 20px;
+}
+
+.ship-table-column-reset {
+    padding: 10px;
+    font-size: 16px;
+    color: var(--menu-font-color);
+    background-color: var(--menu-background-color);
+    cursor: pointer;
+    border: none;
+}
